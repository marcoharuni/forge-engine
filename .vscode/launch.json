{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: ForgeEngine module",
      "type": "debugpy",
      "request": "launch",
      "module": "forge_engine",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Rust: forge-gateway",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--manifest-path",
          "rust/Cargo.toml",
          "--package",
          "forge-gateway"
        ],
        "filter": {
          "name": "forge-gateway",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}

